module top_module( 
    input [2:0] a,
    input [2:0] b,
    output [2:0] out_or_bitwise,
    output out_or_logical,
    output [5:0] out_not
);
    assign out_or_logical = (a[2:0] || b[2:0]); // this will be a single bit output so no need to vectorise for diff msb lsb
    assign out_not[5:0] = {~b[2:0],~a[2:0]};
    assign out_or_bitwise[2:0] = (a[2:0])|(b[2:0]); //for bitwise OR operation just carry out the XOR operation for both the bits 
                               

endmodule
